# =====================================================
# SEGA Cockpit - Backend environment variables
# Copy this file to .env and fill in the values
# =====================================================

# SQL Server connection string (REQUIRED)
# Format: Server=<host>,<port>;Database=<db>;User Id=<user>;Password=<pass>;Encrypt=false
MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=mydatabase;User Id=myuser;Password=mypassword;Encrypt=false

# Backend HTTP port (default: 3001)
PORT=3001

# Database query timeout in milliseconds (default: 5000)
DB_REQUEST_TIMEOUT_MS=5000

# In-memory cache TTL in seconds (default: 60)
CACHE_TTL_SECONDS=60

# Allowed sectors (comma-separated). Leave empty to allow all sectors.
# Example: SECTORS=almacen1,almacen2
SECTORS=

# Timezone for date calculations (default: America/Argentina/Buenos_Aires)
TIMEZONE=America/Argentina/Buenos_Aires
