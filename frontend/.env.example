# =====================================================
# SEGA Cockpit - Frontend environment variables
# Copy this file to .env.local and fill in the values
# =====================================================

# Backend URL used by Next.js API proxy routes (server-side only)
# Default: http://localhost:3001
BACKEND_URL=http://localhost:3001

# Auto-refresh interval in seconds for polling (default: 30)
NEXT_PUBLIC_REFRESH_SECONDS=30

# Minutes of data lag before showing a warning banner (default: 5)
NEXT_PUBLIC_LAG_WARN_MINUTES=5

# Frontend fetch timeout in milliseconds (default: 4000)
NEXT_PUBLIC_FETCH_TIMEOUT_MS=4000
