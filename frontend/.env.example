# =====================================================
# SEGA Cockpit - Frontend environment variables
# Copy this file to .env.local and fill in the values
# =====================================================

# Backend URL used by Next.js API proxy routes (server-side only)
# Default: http://localhost:3001
BACKEND_URL=http://localhost:3001

# Auto-refresh interval in seconds for polling (default: 30)
NEXT_PUBLIC_REFRESH_SECONDS=30

# Minutes of data lag before showing a warning banner (default: 5)
NEXT_PUBLIC_LAG_WARN_MINUTES=5

# Frontend fetch timeout in milliseconds (default: 4000)
NEXT_PUBLIC_FETCH_TIMEOUT_MS=4000

# ─── Per-client branding & module config ──────────────────────────────────────

# Client display name shown in sidebar and browser tab (default: SEGA Cockpit)
NEXT_PUBLIC_CLIENT_NAME=Mi Empresa

# Módulos habilitados (separados por coma). Dejar vacío para mostrar todos.
# Descomentá los que apliquen y copiá los keys a la línea activa:
#
#   fulfillment      → Cumplimiento de pedidos (Fill Rate, faltantes por SKU)
#   productivity     → Productividad de operarios (uni/h, ranking)
#   recepciones      → Recepciones de mercadería (volumen, tiempos)
#   expediciones     → Despachos y cargas de camiones
#   stock-almacenaje → Stock por posición y ocupación del almacén
#   stock            → Inventario, rotación y riesgo de quiebre
#   slotting         → Optimización de slotting (BALDA vs RACK/PALLET, líneas evitables)
#
NEXT_PUBLIC_ENABLED_MODULES=fulfillment,productivity,recepciones,expediciones,stock-almacenaje,stock,slotting
